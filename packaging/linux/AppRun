#!/usr/bin/env sh
# Start the bundled Qt application without inheriting unrelated Qt paths from
# another development installation or package manager.
set -eu
APP_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
unset QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH QML2_IMPORT_PATH QT_QML_IMPORT_PATH
exec "$APP_DIR/bin/cueflow" "$@"
